{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-pr.ts",
        "scripts/check-source.ts"
      ],
      "project": [
        "scripts/**/*.ts"
      ],
      "ignoreDependencies": [
        "@earendil-works/pi-coding-agent"
      ]
    },
    "packages/*": {
      "entry": [
        "test/run.ts",
        "test/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    }
  },
  "includeEntryExports": true,
  "ignoreBinaries": [
    "mshta.exe"
  ]
}
